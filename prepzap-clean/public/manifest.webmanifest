{
  "id": "com.studenius.app",
  "name": "Studenius",
  "short_name": "Studenius",
  "description": "AI-powered study platform — flashcards, quizzes, and Arena battles.",
  "theme_color": "#ae2925",
  "background_color": "#FAF7F2",
  "display": "standalone",
  "orientation": "portrait",
